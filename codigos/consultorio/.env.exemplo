# Copie para .env e ajuste. O .env nunca vai para o Git.
# Endereço do provedor de WhatsApp (o falso, em desenvolvimento: npm run provedor).
WHATSAPP_URL=http://127.0.0.1:4010
# Token do provedor. Com o falso, qualquer texto serve, desde que seja o mesmo
# aqui e no provedor (os dois leem este arquivo).
WHATSAPP_TOKEN=troque-por-um-token
