{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node", "args": ["/CAMINHO/ABSOLUTO/meu-harness/hooks/formatar.mjs"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["/CAMINHO/ABSOLUTO/meu-harness/hooks/commit-so-verde.mjs"] },
          { "type": "command", "command": "node", "args": ["/CAMINHO/ABSOLUTO/meu-harness/hooks/encerrar-pelo-pid.mjs"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["/CAMINHO/ABSOLUTO/meu-harness/hooks/verificar-ao-parar.mjs"] }
        ]
      }
    ]
  }
}
